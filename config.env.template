# Bot Token từ BotFather (@BotFather)
# Tìm: @BotFather → /start → /newbot → đặt tên → username
BOT_TOKEN=your_telegram_bot_token_here

# Chat ID hoặc Group ID của người/nhóm được phép dùng bot
# Tìm ID: @userinfobot → forward tin nhắn tới bot
ALLOWED_CHAT_IDS=123456789,987654321

# Discord Bot Token
# Từ Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Google My Maps ID (để hiển thị bản đồ tuyến)
# Tìm ID từ URL: https://www.google.com/maps/d/edit?mid=YOUR_MAP_ID
MYMAP_ID=your_google_mymap_id_here
